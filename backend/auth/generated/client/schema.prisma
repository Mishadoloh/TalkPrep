datasource db {
  provider = "sqlite"
  url      = "file:./users.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  isPro        Boolean  @default(false)
  credits      Int      @default(1)
  createdAt    DateTime @default(now())
}
