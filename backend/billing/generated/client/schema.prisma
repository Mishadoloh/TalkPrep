datasource db {
  provider = "sqlite"
  url      = "file:./billing.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  credits   Int
  type      String // "PACK" | "SUBSCRIPTION"
  status    String // "SUCCESS" | "FAILED"
  createdAt DateTime @default(now())
}
